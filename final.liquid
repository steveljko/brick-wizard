
{%- comment -%}
  Brick product page (v2)
  Gallery, product info, order wizard and FAQ in one section.
  Desktop: gallery left, everything else right. Mobile: stacked.

  v2: Every Image block is a slide with a thumbnail. When the customer's Count group choices
  match a block's "Show for" rule (e.g. pets=1, figures=1), the slider switches to it.
  The most specific match wins.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign s = section.settings

  assign pp_product = product
  if s.product_handle != blank
    assign pp_product = all_products[s.product_handle]
  endif
  assign pp_variant = pp_product.selected_or_first_available_variant

  assign image_blocks = section.blocks | where: 'type', 'image'
  assign faq_blocks = section.blocks | where: 'type', 'question'
  assign info_types = 'social_proof,title,subtitle,rating,price,installments,feature,text,@app' | split: ','

  if image_blocks.size > 0
    assign slide_count = image_blocks.size
  elsif pp_product.media.size > 0
    assign slide_count = pp_product.media.size
  else
    assign slide_count = 1
  endif

  case s.h_align
    when 'center'
      assign h_flex = 'center'
    else
      assign h_flex = 'flex-start'
  endcase

  case s.title_size
    when 'small'
      assign title_px = 34
    when 'large'
      assign title_px = 52
    else
      assign title_px = 44
  endcase
-%}

<style>
  /* Layout */
  #pp-{{ sid }} {
    --pp-line: color-mix(in srgb, currentColor 14%, transparent);
    background: {{ s.pp_bg }};
    color: {{ s.pp_text }};
    padding: {{ s.pp_pad_top }}px 0 {{ s.pp_pad_bottom }}px;
  }
  #pp-{{ sid }} .pp-wrap { max-width: {{ s.pp_max_width }}px; margin: 0 auto; padding: 0 24px; box-sizing: border-box; }
  #pp-{{ sid }} .pp-top {
    display: grid;
    grid-template-columns: minmax(0, {{ s.pp_gallery_width }}fr) minmax(0, {{ 100 | minus: s.pp_gallery_width }}fr);
    column-gap: 56px;
    align-items: start;
  }
  #pp-{{ sid }} .pp-media, #pp-{{ sid }} .pp-side { min-width: 0; }
  {%- if s.pp_sticky -%}
  #pp-{{ sid }} .pp-media { position: sticky; top: {{ s.pp_sticky_top }}px; }
  {%- endif -%}
  #pp-{{ sid }} .pp-faq-full .faq { max-width: 760px; margin-left: auto; margin-right: auto; }

  @media (max-width: 989px) {
    #pp-{{ sid }} { padding: {{ s.pp_pad_top | times: 0.5 | round }}px 0 {{ s.pp_pad_bottom | times: 0.5 | round }}px; }
    #pp-{{ sid }} .pp-wrap { padding: 0; }
    #pp-{{ sid }} .pp-top { grid-template-columns: minmax(0, 1fr); row-gap: 24px; }
    #pp-{{ sid }} .pp-media { position: static; }
    #pp-{{ sid }} .pp-side, #pp-{{ sid }} .pp-faq-full { width: 100%; max-width: 680px; margin: 0 auto; padding: 0 16px; box-sizing: border-box; }
  }

  /* Gallery */
  #pp-{{ sid }} .pg-main {
    position: relative; width: 100%; aspect-ratio: {{ s.g_aspect }}; max-height: 85vh;
    border-radius: {{ s.g_radius }}px; overflow: hidden; background: #f5f5f5; touch-action: pan-y;
  }
  #pp-{{ sid }} .pg-slide { position: absolute; inset: 0; opacity: 0; transition: opacity .45s ease; pointer-events: none; }
  #pp-{{ sid }} .pg-slide.is-active { opacity: 1; pointer-events: auto; }
  #pp-{{ sid }} .pg-slide img, #pp-{{ sid }} .pg-slide svg { display: block; width: 100%; height: 100%; object-fit: {{ s.g_fit }}; }
  #pp-{{ sid }} .pg-arrow {
    position: absolute; top: 50%; z-index: 2; transform: translateY(-50%);
    width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;
    border: 0; border-radius: 50%; background: rgba(255,255,255,.9); color: #222; font-size: 22px; line-height: 1;
    box-shadow: 0 2px 8px rgba(0,0,0,.15); cursor: pointer; transition: background .2s;
  }
  #pp-{{ sid }} .pg-arrow:hover { background: #fff; }
  #pp-{{ sid }} .pg-prev { left: 14px; }
  #pp-{{ sid }} .pg-next { right: 14px; }
  #pp-{{ sid }} .pg-dots {
    display: {% if s.g_thumbs %}none{% else %}flex{% endif %};
    position: absolute; left: 50%; bottom: 12px; z-index: 3; transform: translateX(-50%);
    align-items: center; gap: 6px; padding: 6px 10px; border-radius: 20px;
    background: rgba(0,0,0,.25); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
  }
  #pp-{{ sid }} .pg-dot { width: 7px; height: 7px; padding: 0; border: 0; border-radius: 50%; background: rgba(255,255,255,.55); cursor: pointer; transition: width .25s, background .25s; }
  #pp-{{ sid }} .pg-dot.is-active { width: 20px; border-radius: 4px; background: #fff; }
  #pp-{{ sid }} .pg-thumbs { display: flex; gap: 10px; margin-top: 12px; overflow-x: auto; scroll-behavior: smooth; scrollbar-width: none; }
  #pp-{{ sid }} .pg-thumbs::-webkit-scrollbar { display: none; }
  #pp-{{ sid }} .pg-thumb {
    flex: 0 0 auto; width: 76px; aspect-ratio: {{ s.g_aspect }}; padding: 0; overflow: hidden;
    border: 2px solid transparent; border-radius: {{ s.g_radius | divided_by: 2 }}px;
    background: #f5f5f5; opacity: .7; cursor: pointer; transition: opacity .2s, border-color .2s;
  }
  #pp-{{ sid }} .pg-thumb:hover { opacity: 1; }
  #pp-{{ sid }} .pg-thumb.is-active { opacity: 1; border-color: currentColor; }
  #pp-{{ sid }} .pg-thumb img, #pp-{{ sid }} .pg-thumb svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 989px) {
    #pp-{{ sid }} .pg-main { max-height: none; border-radius: 0; }
    #pp-{{ sid }} .pg-arrow, #pp-{{ sid }} .pg-thumbs { display: none; }
    #pp-{{ sid }} .pg-dots { display: flex; }
  }

  /* Product info */
  #pp-{{ sid }} .ph { display: flex; flex-direction: column; align-items: {{ h_flex }}; text-align: {{ s.h_align }}; margin-bottom: 28px; }
  #pp-{{ sid }} .ph-block { width: 100%; }
  #pp-{{ sid }} .ph-block + .ph-block { margin-top: 12px; }
  #pp-{{ sid }} .ph-block + .ph-block--title { margin-top: 14px; }
  #pp-{{ sid }} .ph-block + .ph-block--subtitle { margin-top: 6px; }
  #pp-{{ sid }} .ph-block--feature + .ph-block--feature { margin-top: 8px; }
  #pp-{{ sid }} :not(.ph-block--feature) + .ph-block--feature { margin-top: 18px; }
  #pp-{{ sid }} .ph p { margin: 0; }

  #pp-{{ sid }} .ph-proof { display: flex; justify-content: {{ h_flex }}; }
  #pp-{{ sid }} .ph-proof-inner { --av: 44px; display: inline-flex; align-items: center; }
  #pp-{{ sid }} .ph-avatars { position: relative; z-index: 1; display: flex; }
  #pp-{{ sid }} .ph-avatar { position: relative; flex: 0 0 auto; width: var(--av); height: var(--av); margin-left: calc(var(--av) * -0.28); border: 2px solid #fff; border-radius: 50%; background: #ddd; }
  #pp-{{ sid }} .ph-avatar:first-child { margin-left: 0; }
  #pp-{{ sid }} .ph-avatar img { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
  #pp-{{ sid }} .ph-check { position: absolute; top: -4px; right: -2px; width: 17px; height: 17px; display: flex; align-items: center; justify-content: center; border: 2px solid #fff; border-radius: 50%; }
  #pp-{{ sid }} .ph-check svg { width: 60%; height: 60%; }
  #pp-{{ sid }} .ph-pill { display: flex; flex-direction: column; justify-content: center; min-height: 36px; padding: 6px 20px; border-radius: 999px; line-height: 1.15; text-align: center; color: #fff; }
  #pp-{{ sid }} .ph-avatars + .ph-pill { margin-left: calc(var(--av) * -0.5); padding-left: calc(var(--av) * 0.5 + 14px); border-radius: 0 999px 999px 0; }
  #pp-{{ sid }} .ph-pill strong { display: block; font-size: 16px; font-weight: 800; }
  #pp-{{ sid }} .ph-pill span { font-size: 12px; opacity: .95; }

  #pp-{{ sid }} .ph-title { margin: 0; font-size: clamp({{ title_px | times: 0.72 | round }}px, 7vw, {{ title_px }}px); font-weight: 800; line-height: 1.05; letter-spacing: -0.01em; }
  #pp-{{ sid }} .ph-title a { color: inherit; }
  #pp-{{ sid }} .ph-subtitle { font-size: 18px; line-height: 1.4; opacity: .85; }

  #pp-{{ sid }} .ph-rating { display: flex; flex-wrap: wrap; align-items: center; justify-content: {{ h_flex }}; gap: 8px; font-size: 15px; }
  #pp-{{ sid }} .ph-stars { display: inline-flex; gap: 1px; line-height: 0; }
  #pp-{{ sid }} .ph-stars svg { width: 16px; height: 16px; }

  #pp-{{ sid }} .ph-price { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: {{ h_flex }}; gap: 10px; }
  #pp-{{ sid }} .ph-price-prefix { font-size: 16px; }
  #pp-{{ sid }} .ph-price-now { font-size: 26px; font-weight: 800; }
  #pp-{{ sid }} .ph-price-was { font-size: 19px; font-weight: 700; text-decoration: line-through; opacity: .55; }
  #pp-{{ sid }} .ph-badge { align-self: center; padding: 3px 8px; border-radius: 4px; color: #fff; font-size: 12px; font-weight: 700; }

  #pp-{{ sid }} .ph-installments { font-size: 14px; }
  #pp-{{ sid }} .ph-installments shopify-payment-terms { display: block; }

  #pp-{{ sid }} .ph-feature { display: flex; align-items: flex-start; gap: 10px; font-size: 16px; line-height: 1.4; text-align: left; }
  #pp-{{ sid }} .ph-feature-icon { flex: 0 0 auto; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 20px; line-height: 1; }
  #pp-{{ sid }} .ph-feature-icon img { width: 100%; height: 100%; object-fit: contain; }
  #pp-{{ sid }} .ph-custom { font-size: 16px; line-height: 1.5; }

  @media (max-width: 749px) {
    #pp-{{ sid }} .ph-pill strong { font-size: 14px; }
    #pp-{{ sid }} .ph-pill span { font-size: 11px; }
    #pp-{{ sid }} .ph-subtitle { font-size: 16px; }
    #pp-{{ sid }} .ph-feature, #pp-{{ sid }} .ph-custom { font-size: 15px; }
    #pp-{{ sid }} .ph-rating { font-size: 14px; }
  }

  /* FAQ */
  #pp-{{ sid }} .faq { margin-top: 40px; }
  #pp-{{ sid }} .faq-heading { margin: 0 0 12px; font-size: 24px; font-weight: 800; }
  #pp-{{ sid }} .faq-item { border-bottom: 1px solid var(--pp-line); }
  #pp-{{ sid }} .faq-item:first-of-type { border-top: 1px solid var(--pp-line); }
  #pp-{{ sid }} .faq summary { display: flex; align-items: center; gap: 14px; padding: 16px 4px; list-style: none; cursor: pointer; user-select: none; -webkit-tap-highlight-color: transparent; }
  #pp-{{ sid }} .faq summary::-webkit-details-marker { display: none; }
  #pp-{{ sid }} .faq summary::marker { content: ''; }
  #pp-{{ sid }} .faq summary:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; border-radius: 4px; }
  #pp-{{ sid }} .faq-icon { flex: 0 0 auto; width: 22px; height: 22px; display: flex; align-items: center; justify-content: center; }
  #pp-{{ sid }} .faq-icon svg, #pp-{{ sid }} .faq-icon img { width: 100%; height: 100%; object-fit: contain; }
  #pp-{{ sid }} .faq-q { flex: 1; font-size: 17px; font-weight: 700; line-height: 1.35; }
  #pp-{{ sid }} .faq-q p { margin: 0; }
  #pp-{{ sid }} .faq-chevron { flex: 0 0 auto; width: 16px; height: 16px; transition: transform .3s ease; }
  #pp-{{ sid }} .faq details[open] .faq-chevron { transform: rotate(180deg); }
  #pp-{{ sid }} .faq-a-outer { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; }
  #pp-{{ sid }} .faq details[open] .faq-a-outer { grid-template-rows: 1fr; }
  #pp-{{ sid }} .faq-a-inner { overflow: hidden; }
  #pp-{{ sid }} .faq-a { padding: 0 4px 16px 40px; font-size: 15px; line-height: 1.55; opacity: .8; }
  #pp-{{ sid }} .faq-item--plain .faq-a { padding-left: 4px; }
  #pp-{{ sid }} .faq-a p { margin: 0 0 10px; }
  #pp-{{ sid }} .faq-a p:last-child { margin-bottom: 0; }
  #pp-{{ sid }} .faq-a img { display: block; max-width: 100%; height: auto; margin-top: 10px; border-radius: 8px; }
  @media (max-width: 749px) {
    #pp-{{ sid }} .faq summary { gap: 12px; padding: 14px 2px; }
    #pp-{{ sid }} .faq-q { font-size: 16px; }
    #pp-{{ sid }} .faq-a { padding-left: 36px; font-size: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #pp-{{ sid }} .pg-slide, #pp-{{ sid }} .pg-dot, #pp-{{ sid }} .pg-thumb,
    #pp-{{ sid }} .faq-chevron, #pp-{{ sid }} .faq-a-outer { transition: none; }
    #pp-{{ sid }} .pg-thumbs { scroll-behavior: auto; }
  }
</style>

{%- capture faq_html -%}
  {%- if faq_blocks.size > 0 -%}
    <div class="faq" data-faq data-single="{% if s.f_allow_multiple %}false{% else %}true{% endif %}">
      {%- if s.f_heading != blank -%}<h2 class="faq-heading">{{ s.f_heading }}</h2>{%- endif -%}
      {%- for block in faq_blocks -%}
        {%- assign bs = block.settings -%}
        {%- liquid
          assign has_icon = true
          if bs.icon_image == blank and bs.icon == 'none'
            assign has_icon = false
          endif
        -%}
        <details class="faq-item{% unless has_icon %} faq-item--plain{% endunless %}" {% if s.f_open_first and forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            {%- if has_icon -%}
              <span class="faq-icon" aria-hidden="true">
                {%- if bs.icon_image != blank -%}
                  {{ bs.icon_image | image_url: width: 80 | image_tag: alt: '' }}
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  {%- case bs.icon -%}
                    {%- when 'heart' -%}<path d="M12 20.5s-7.5-4.6-9.2-9.4C1.6 7.6 3.9 4 7.5 4c2 0 3.5 1.1 4.5 2.6C13 5.1 14.5 4 16.5 4c3.6 0 5.9 3.6 4.7 7.1-1.7 4.8-9.2 9.4-9.2 9.4z"/>
                    {%- when 'eye' -%}<path d="M1.5 12S5.5 5 12 5s10.5 7 10.5 7-4 7-10.5 7S1.5 12 1.5 12z"/><circle cx="12" cy="12" r="3.2"/>
                    {%- when 'truck' -%}<path d="M1.5 6h12v10h-12z"/><path d="M13.5 9.5h4.2l3.3 3.3V16h-7.5"/><circle cx="5.5" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
                    {%- when 'gift' -%}<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12"/><path d="M12 8S10.5 3.5 8 4.2C6 4.8 7 8 12 8zM12 8s1.5-4.5 4-3.8C18 4.8 17 8 12 8z"/>
                    {%- when 'box' -%}<path d="M3 7.5L12 3l9 4.5v9L12 21l-9-4.5z"/><path d="M3 7.5L12 12l9-4.5M12 12v9"/>
                    {%- when 'star' -%}<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>
                    {%- when 'shield' -%}<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>
                    {%- when 'chat' -%}<path d="M4 5h16v11H9l-5 4z"/>
                    {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>
                    {%- when 'camera' -%}<path d="M3 8h4l2-3h6l2 3h4v11H3z"/><circle cx="12" cy="13" r="3.5"/>
                    {%- when 'return' -%}<path d="M9 14L4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 010 11H11"/>
                    {%- when 'card' -%}<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19M6 15h4"/>
                    {%- when 'question' -%}<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 114 2c-1 .6-1.5 1.2-1.5 2.3M12 17h.01"/>
                  {%- endcase -%}
                  </svg>
                {%- endif -%}
              </span>
            {%- endif -%}
            <span class="faq-q">{{ bs.question }}</span>
            <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="faq-a-outer">
            <div class="faq-a-inner">
              <div class="faq-a">
                {{ bs.answer }}
                {%- if bs.answer_image != blank -%}
                  {{ bs.answer_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: '' }}
                {%- endif -%}
              </div>
            </div>
          </div>
        </details>
      {%- endfor -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<div id="pp-{{ sid }}" class="pp">
  <div class="pp-wrap">
    <div class="pp-top">

      {%- comment -%} Gallery {%- endcomment -%}
      <div class="pp-media">
        <div class="pg-gallery" data-pg data-autoplay="{% if s.g_autoplay %}{{ s.g_autoplay_speed | times: 1000 }}{% else %}0{% endif %}">
          <div class="pg-main">
            {%- if image_blocks.size > 0 -%}
              {%- assign n = 0 -%}
              {%- for block in image_blocks -%}
                {%- liquid
                  assign rule = block.settings.match | strip
                  assign img_alt = block.settings.image.alt | default: pp_product.title
                  assign img_loading = 'lazy'
                  if n == 0
                    assign img_loading = 'eager'
                  endif
                -%}
                <div class="pg-slide{% if n == 0 %} is-active{% endif %}" data-index="{{ n }}"{% if rule != blank %} data-match="{{ rule | escape }}"{% endif %} {{ block.shopify_attributes }}>
                  {%- assign n = n | plus: 1 -%}
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 2000 | image_tag:
                        widths: '600, 900, 1200, 1600, 2000',
                        sizes: '(min-width: 990px) 55vw, 100vw',
                        alt: img_alt,
                        loading: img_loading }}
                  {%- else -%}
                    {{ 'product-apparel-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- elsif pp_product.media.size > 0 -%}
              {%- for media in pp_product.media -%}
                {%- liquid
                  assign img_alt = media.alt | default: pp_product.title
                  assign img_loading = 'lazy'
                  if forloop.first
                    assign img_loading = 'eager'
                  endif
                -%}
                <div class="pg-slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}">
                  {{ media.preview_image | image_url: width: 2000 | image_tag:
                      widths: '600, 900, 1200, 1600, 2000',
                      sizes: '(min-width: 990px) 55vw, 100vw',
                      alt: img_alt,
                      loading: img_loading }}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="pg-slide is-active" data-index="0">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
            {%- endif -%}

            {%- if slide_count > 1 -%}
              {%- if s.g_arrows -%}
                <button type="button" class="pg-arrow pg-prev" aria-label="{{ s.a11y_prev | escape }}">&#8249;</button>
                <button type="button" class="pg-arrow pg-next" aria-label="{{ s.a11y_next | escape }}">&#8250;</button>
              {%- endif -%}
              <div class="pg-dots">
                {%- for i in (1..slide_count) -%}
                  <button type="button" class="pg-dot{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="{{ s.a11y_image | replace: '[n]', i | escape }}"></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>

          {%- if slide_count > 1 and s.g_thumbs -%}
            <div class="pg-thumbs">
              {%- if image_blocks.size > 0 -%}
                {%- assign n = 0 -%}
                {%- for block in image_blocks -%}
                  {%- assign n_label = n | plus: 1 -%}
                  <button type="button" class="pg-thumb{% if n == 0 %} is-active{% endif %}" data-index="{{ n }}" aria-label="{{ s.a11y_image | replace: '[n]', n_label | escape }}">
                    {%- assign n = n | plus: 1 -%}
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
                    {%- else -%}
                      {{ 'product-apparel-1' | placeholder_svg_tag }}
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              {%- else -%}
                {%- for media in pp_product.media -%}
                  <button type="button" class="pg-thumb{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="{{ s.a11y_image | replace: '[n]', forloop.index | escape }}">
                    {{ media.preview_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
                  </button>
                {%- endfor -%}
              {%- endif -%}
            </div>
          {%- endif -%}

        </div>
      </div>

      {%- comment -%} Product info, wizard, FAQ {%- endcomment -%}
      <div class="pp-side">
        <div class="ph">
          {%- for block in section.blocks -%}
            {%- unless info_types contains block.type -%}{%- continue -%}{%- endunless -%}
            {%- assign bs = block.settings -%}
            {%- if block.type == '@app' -%}
              <div class="ph-block" {{ block.shopify_attributes }}>{% render block %}</div>
              {%- continue -%}
            {%- endif -%}
            <div class="ph-block ph-block--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}

              {%- when 'social_proof' -%}
                {%- liquid
                  assign avatars = ''
                  for i in (1..5)
                    assign key = 'avatar_' | append: i
                    if bs[key] != blank
                      assign avatars = 'yes'
                    endif
                  endfor
                -%}
                <div class="ph-proof">
                  <div class="ph-proof-inner">
                    {%- if avatars != blank -%}
                      <div class="ph-avatars">
                        {%- for i in (1..5) -%}
                          {%- assign key = 'avatar_' | append: i -%}
                          {%- if bs[key] != blank -%}
                            <div class="ph-avatar">
                              {{ bs[key] | image_url: width: 120 | image_tag: alt: '', loading: 'lazy' }}
                              <span class="ph-check" style="background: {{ bs.pill_color }};">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
                              </span>
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                    <div class="ph-pill" style="background: {{ bs.pill_color }};">
                      {%- if bs.line_1 != blank -%}<strong>{{ bs.line_1 }}</strong>{%- endif -%}
                      {%- if bs.line_2 != blank -%}<span>{{ bs.line_2 }}</span>{%- endif -%}
                    </div>
                  </div>
                </div>

              {%- when 'title' -%}
                <h1 class="ph-title">
                  {%- if bs.text != blank -%}{{ bs.text }}{%- else -%}{{ pp_product.title | default: 'Product title' }}{%- endif -%}
                </h1>

              {%- when 'subtitle' -%}
                <div class="ph-subtitle">{{ bs.text }}</div>

              {%- when 'rating' -%}
                <div class="ph-rating">
                  <span class="ph-stars" role="img" aria-label="{{ s.a11y_rating | replace: '[rating]', bs.rating | escape }}">
                    {%- for i in (1..5) -%}
                      {%- assign fill_pct = 0 -%}
                      {%- assign diff = bs.rating | minus: i | plus: 1 -%}
                      {%- if diff >= 1 -%}{%- assign fill_pct = 100 -%}
                      {%- elsif diff > 0 -%}{%- assign fill_pct = diff | times: 100 | round -%}{%- endif -%}
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <defs><linearGradient id="g-{{ block.id }}-{{ i }}"><stop offset="{{ fill_pct }}%" stop-color="#f5b301"/><stop offset="{{ fill_pct }}%" stop-color="#d9d9d9"/></linearGradient></defs>
                        <path fill="url(#g-{{ block.id }}-{{ i }})" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/>
                      </svg>
                    {%- endfor -%}
                  </span>
                  {%- if bs.text != blank -%}<span>{{ bs.text }}</span>{%- endif -%}
                </div>

              {%- when 'price' -%}
                <div class="ph-price">
                  {%- if bs.prefix != blank -%}<span class="ph-price-prefix">{{ bs.prefix }}</span>{%- endif -%}
                  <span class="ph-price-now">{{ pp_variant.price | money }}</span>
                  {%- if pp_variant.compare_at_price > pp_variant.price -%}
                    <span class="ph-price-was">{{ pp_variant.compare_at_price | money }}</span>
                  {%- endif -%}
                  {%- if bs.badge != blank -%}
                    <span class="ph-badge" style="background: {{ bs.badge_bg }};">{{ bs.badge }}</span>
                  {%- endif -%}
                </div>

              {%- when 'installments' -%}
                <div class="ph-installments">
                  {%- if bs.mode == 'shopify' and pp_product != blank -%}
                    {%- assign terms_id = 'ph-terms-' | append: block.id -%}
                    {%- form 'product', pp_product, id: terms_id -%}
                      <input type="hidden" name="id" value="{{ pp_variant.id }}">
                      {{ form | payment_terms }}
                    {%- endform -%}
                  {%- else -%}
                    {{ bs.text }}
                  {%- endif -%}
                </div>

              {%- when 'feature' -%}
                <div class="ph-feature">
                  {%- if bs.icon_image != blank or bs.emoji != blank -%}
                    <span class="ph-feature-icon">
                      {%- if bs.icon_image != blank -%}
                        {{ bs.icon_image | image_url: width: 64 | image_tag: alt: '' }}
                      {%- else -%}
                        {{ bs.emoji }}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                  <div class="ph-feature-text">{{ bs.text }}</div>
                </div>

              {%- when 'text' -%}
                <div class="ph-custom">{{ bs.text }}</div>

            {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>

        <div class="pp-buy">
{%- liquid
  assign has_groups = false
  assign has_extras = false
  for block in section.blocks
    if block.type == 'figure' and block.settings.product != blank
      assign has_groups = true
    endif
    if block.type == 'extra' and block.settings.product != blank
      assign has_extras = true
    endif
  endfor

  assign render_product = s.render_product
  assign render_variant = render_product.selected_or_first_available_variant

  assign max_files = s.max_files | append: ''
  assign max_mb = s.max_photo_mb | append: ''
  assign limits_text = s.limits_label | replace: '[count]', max_files | replace: '[size]', max_mb
-%}

<brickset-wizard
  class="bw"
  style="--bw-accent: {{ s.accent }}; --bw-ink: {{ s.ink }}; --bw-card: #fff; --bw-sticky-top: {{ s.sticky_offset }}px;"
>
  <script type="application/json" data-bw-config>
    {
      "moneyFormat": {{ shop.money_format | strip_html | json }},
      "redirect": {{ s.redirect | json }},
      "maxMb": {{ s.max_photo_mb | json }},
      "maxFiles": {{ s.max_files | json }},
      "resizePx": 2500,
      "text": {
        "continue": {{ s.continue_label | json }},
        "checkout": {{ s.checkout_label | json }},
        "stepText": {{ s.step_text | json }},
        "noFigures": {{ s.msg_no_figures | json }},
        "noPhoto": {{ s.error_photo | json }},
        "extrasText": {{ s.error_extras_text | json }},
        "approve": {{ s.error_approve | json }},
        "tooBig": {{ s.error_too_big | json }},
        "tooMany": {{ s.error_too_many | json }},
        "notImage": {{ s.error_not_image | json }},
        "cartError": {{ s.error_cart | json }},
        "photosTitle": {{ s.photos_step_label | json }},
        "savings": {{ s.savings_label | json }},
        "preparing": {{ s.preparing_label | json }},
        "photos": {{ s.photos_count_label | json }},
        "remove": {{ s.remove_label | json }},
        "prev": {{ s.a11y_prev | json }},
        "next": {{ s.a11y_next | json }},
        "close": {{ s.a11y_close | json }},
        "openPhoto": {{ s.a11y_open_photo | json }}
      }
    }
  </script>

  <noscript>
    <style>#pp-{{ section.id }} .bw-stepper, #pp-{{ section.id }} .bw-summary, #pp-{{ section.id }} .bw-nav { display: none; }</style>
    <p class="bw-alert">{{ s.noscript_text }}</p>
  </noscript>

  <ol class="bw-stepper" data-bw-stepper aria-label="Progress"></ol>

  <div class="bw-summary">
    <div class="bw-summary__step">
      <span class="bw-summary__steptext" data-bw-steptext></span>
      <span class="bw-progress" aria-hidden="true"><span class="bw-progress__bar" data-bw-progress></span></span>
    </div>
    <div class="bw-summary__total" data-bw-total hidden aria-live="polite">
      <span class="bw-summary__label">{{ s.total_label }}</span>
      <strong class="bw-summary__amount" data-bw-total-amount></strong>
    </div>
  </div>

  {%- comment -%} ───────── Step 1: pets + people + photos ───────── {%- endcomment -%}
  <section class="bw-step" data-bw-step="figures" data-label="{{ s.figures_label | escape }}" aria-labelledby="bw-{{ section.id }}-figures" hidden>
    <h2 class="bw-h" id="bw-{{ section.id }}-figures" tabindex="-1">{{ s.figures_heading }}</h2>
    {%- if s.figures_sub != blank -%}<p class="bw-sub">{{ s.figures_sub }}</p>{%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type != 'figure' -%}{%- continue -%}{%- endif -%}

      {%- if block.settings.product == blank -%}
        {%- if request.design_mode -%}
          <p class="bw-placeholder" {{ block.shopify_attributes }}>Count group: choose a product in the block settings.</p>
        {%- endif -%}
        {%- continue -%}
      {%- endif -%}

      {%- liquid
        assign p = block.settings.product
        assign lines = block.settings.card_lines | newline_to_br | split: '<br />'
        assign group = 'bw-' | append: block.id
        assign layout = 'grid'
        if block.settings.list_layout
          assign layout = 'list'
        endif
      -%}

      <div class="bw-group" data-bw-group data-block-id="{{ block.id }}" data-key="{{ block.settings.key | strip | escape }}" data-required="{{ block.settings.is_required }}" data-err-select="{{ block.settings.error_select | escape }}" {{ block.shopify_attributes }}>
        <h3 class="bw-group__h" id="{{ group }}-h">
          {{- block.settings.heading -}}
          {%- unless block.settings.is_required %} <span class="bw-group__optional">{{ s.optional_label }}</span>{% endunless -%}
        </h3>
        {%- if block.settings.subheading != blank -%}<p class="bw-group__sub">{{ block.settings.subheading }}</p>{%- endif -%}

        <div class="bw-opts bw-opts--{{ layout }}" role="radiogroup" aria-labelledby="{{ group }}-h" data-bw-options>
          {%- for variant in p.variants -%}
            {%- liquid
              assign vi = forloop.index0
              assign opt_icon = ''
              assign opt_name = ''
              assign opt_desc = ''
              assign matched = false

              for line in lines
                assign parts = line | strip | split: '|'
                if parts.size > 3
                  assign key = parts[0] | strip
                  if key == variant.option1
                    assign opt_icon = parts[1] | strip
                    assign opt_name = parts[2] | strip
                    assign opt_desc = parts[3] | strip
                    assign matched = true
                    break
                  endif
                endif
              endfor

              unless matched
                assign parts = lines[vi] | strip | split: '|'
                if parts.size < 4
                  assign opt_icon = parts[0] | strip
                  assign opt_name = parts[1] | strip
                  assign opt_desc = parts[2] | strip
                endif
              endunless

              if opt_name == blank
                assign opt_name = variant.title
              endif

              assign item_title = p.title
              unless variant.title == 'Default Title'
                assign item_title = item_title | append: ' · ' | append: opt_name
              endunless
            -%}

            <label class="bw-opt{% unless variant.available %} is-disabled{% endunless %}">
              <input
                type="radio"
                class="bw-vh"
                name="{{ group }}"
                value="{{ variant.id }}"
                data-bw-option
                data-value="{{ variant.option1 | escape }}"
                data-price="{{ variant.price }}"
                data-compare="{{ variant.compare_at_price | default: 0 }}"
                data-title="{{ item_title | escape }}"
                {% unless variant.available %}disabled{% endunless %}
              >
              <span class="bw-opt__radio" aria-hidden="true"></span>
              {%- if opt_icon != blank -%}<span class="bw-opt__icon" aria-hidden="true">{{ opt_icon }}</span>{%- endif -%}
              <span class="bw-opt__body">
                <span class="bw-opt__name">{{ opt_name }}</span>
                {%- if opt_desc != blank -%}<span class="bw-opt__desc">{{ opt_desc }}</span>{%- endif -%}
              </span>
              <span class="bw-opt__price">
                {%- if variant.available -%}
                  <span class="bw-opt__now">
                    {%- if s.price_prefix != blank -%}<small>{{ s.price_prefix }}</small> {% endif -%}
                    {{- variant.price | money -}}
                  </span>
                  {%- if variant.compare_at_price > variant.price -%}
                    <s class="bw-opt__was">{{ variant.compare_at_price | money }}</s>
                  {%- endif -%}
                {%- else -%}
                  <span class="bw-opt__soldout">{{ s.sold_out_label }}</span>
                {%- endif -%}
              </span>
            </label>
          {%- endfor -%}
        </div>

      </div>
    {%- endfor -%}

  </section>

  {%- comment -%} ───────── Step 2: photos ───────── {%- endcomment -%}
  {%- if has_groups -%}
    <section class="bw-step" data-bw-step="photos" data-label="{{ s.photos_step_label | escape }}" aria-labelledby="bw-{{ section.id }}-photos" hidden>
      <h2 class="bw-h" id="bw-{{ section.id }}-photos" tabindex="-1">{{ s.upload_heading }}</h2>
      {%- if s.photos_sub != blank -%}<p class="bw-sub">{{ s.photos_sub }}</p>{%- endif -%}
      <div class="bw-upload">
        <label class="bw-drop" data-bw-drop>
          <input type="file" class="bw-vh" accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.jpg,.jpeg,.png,.webp,.heic,.heif" multiple data-bw-file>
          <span class="bw-btn bw-btn--outline">
            <span data-bw-btn-first>{{ s.upload_button }}</span>
            <span data-bw-btn-more hidden>{{ s.upload_more_label }}</span>
          </span>
          <span class="bw-drop__hint" data-bw-hint>{{ s.upload_hint }}</span>
          <span class="bw-drop__limits">{{ limits_text }}</span>
        </label>
        <div class="bw-thumbs" data-bw-thumbs></div>
        <p class="bw-error" data-bw-file-error role="alert"></p>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ───────── Extras ───────── {%- endcomment -%}
  {%- if has_extras -%}
    <section class="bw-step" data-bw-step="extras" data-label="{{ s.extras_label | escape }}" aria-labelledby="bw-{{ section.id }}-extras" hidden>
      <h2 class="bw-h" id="bw-{{ section.id }}-extras" tabindex="-1">{{ s.extras_heading }}</h2>
      {%- if s.extras_note != blank -%}
        <p class="bw-pill">
          {%- if s.extras_note_badge != blank -%}<span class="bw-badge">{{ s.extras_note_badge }}</span>{%- endif -%}
          {{ s.extras_note }}
        </p>
      {%- endif -%}
      <div class="bw-extras">
        {%- for block in section.blocks -%}
          {%- if block.type == 'extra' and block.settings.product != blank -%}
            {%- liquid
              assign p = block.settings.product
              assign v = p.selected_or_first_available_variant
              assign img = block.settings.image | default: p.featured_image
            -%}
            <div
              class="bw-extra{% unless v.available %} is-disabled{% endunless %}"
              data-bw-extra
              data-key="{{ block.id }}"
              data-variant-id="{{ v.id }}"
              data-price="{{ v.price }}"
              data-compare="{{ v.compare_at_price | default: 0 }}"
              data-title="{{ p.title | escape }}"
              {{ block.shopify_attributes }}
            >
              <label class="bw-extra__label">
                <input type="checkbox" class="bw-vh" data-bw-extra-check {% unless v.available %}disabled{% endunless %}>
                {%- if block.settings.badge != blank -%}<span class="bw-badge bw-badge--float">{{ block.settings.badge }}</span>{%- endif -%}
                <span class="bw-extra__media">
                  {%- if img != blank -%}
                    {{ img | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 240px, 50vw', alt: p.title }}
                  {%- endif -%}
                  <span class="bw-extra__check" aria-hidden="true">✓</span>
                </span>
                <span class="bw-extra__title">{{ p.title }}</span>
                {%- if block.settings.description != blank -%}<span class="bw-extra__desc">{{ block.settings.description }}</span>{%- endif -%}
                <span class="bw-extra__price">
                  {%- if v.available -%}
                    {{- v.price | money -}}
                    {%- if v.compare_at_price > v.price %} <s class="bw-was">{{ v.compare_at_price | money }}</s>{% endif -%}
                  {%- else -%}{{ s.sold_out_label }}{%- endif -%}
                </span>
              </label>
              {%- if block.settings.needs_text -%}
                <div class="bw-extra__text" data-bw-extra-text hidden>
                  <input
                    type="text"
                    class="bw-input"
                    maxlength="{{ block.settings.text_max }}"
                    placeholder="{{ block.settings.text_placeholder | escape }}"
                    aria-label="{{ block.settings.text_property | escape }}"
                    enterkeyhint="next"
                    autocomplete="off"
                    data-property="{{ block.settings.text_property | escape }}"
                    data-error="{{ block.settings.text_error | escape }}"
                  >
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ───────── Approve (paid rendering) ───────── {%- endcomment -%}
  {%- if render_product != blank -%}
    <section
      class="bw-step"
      data-bw-step="approve"
      data-label="{{ s.approve_label | escape }}"
      data-render-variant="{{ render_variant.id }}"
      data-render-price="{{ render_variant.price }}"
      data-render-compare="{{ render_variant.compare_at_price | default: 0 }}"
      data-render-title="{{ render_product.title | escape }}"
      aria-labelledby="bw-{{ section.id }}-approve"
      hidden
    >
      <h2 class="bw-h" id="bw-{{ section.id }}-approve" tabindex="-1">{{ s.approve_heading }}</h2>
      {%- if s.approve_text != blank -%}<p class="bw-sub bw-sub--narrow">{{ s.approve_text }}</p>{%- endif -%}
      <div class="bw-approve" role="radiogroup" aria-labelledby="bw-{{ section.id }}-approve">
        <label class="bw-choice" data-bw-choice>
          <input type="radio" class="bw-vh" name="bw-render-{{ section.id }}" value="yes">
          {%- if s.yes_image != blank -%}
            {{ s.yes_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'bw-choice__img', alt: '' }}
          {%- endif -%}
          <span class="bw-choice__title">{{ s.yes_title }}</span>
          <span class="bw-choice__text">{{ s.yes_text }}</span>
          <span class="bw-choice__price">
            {{- render_variant.price | money -}}
            {%- if render_variant.compare_at_price > render_variant.price %} <s class="bw-was">{{ render_variant.compare_at_price | money }}</s>{% endif -%}
          </span>
        </label>
        <label class="bw-choice" data-bw-choice>
          <input type="radio" class="bw-vh" name="bw-render-{{ section.id }}" value="no">
          <span class="bw-choice__title">{{ s.no_title }}</span>
          <span class="bw-choice__text">{{ s.no_text }}</span>
          <span class="bw-choice__price">{{ s.no_price_label }}</span>
        </label>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ───────── Review ───────── {%- endcomment -%}
  <section class="bw-step" data-bw-step="review" data-label="{{ s.review_label | escape }}" aria-labelledby="bw-{{ section.id }}-review" hidden>
    <h2 class="bw-h" id="bw-{{ section.id }}-review" tabindex="-1">{{ s.review_heading }}</h2>
    <div class="bw-review" data-bw-review></div>
    <div class="bw-review-total">
      <span>{{ s.total_label }}</span>
      <strong data-bw-review-total></strong>
    </div>
    <p class="bw-review-save" data-bw-review-save hidden></p>
  </section>

  <p class="bw-alert" data-bw-alert role="alert"></p>

  <div class="bw-nav">
    <button type="button" class="bw-link" data-bw-back hidden>{{ s.back_label }}</button>
    <button type="button" class="bw-btn bw-btn--primary bw-next" data-bw-next>{{ s.continue_label }}</button>
  </div>
</brickset-wizard>
        </div>

        {%- if s.f_position == 'side' -%}{{ faq_html }}{%- endif -%}
      </div>

    </div>

    {%- if s.f_position == 'full' -%}
      <div class="pp-faq-full">{{ faq_html }}</div>
    {%- endif -%}
  </div>
</div>


<style>
brickset-wizard { display: block; }

.bw {
  /* Set per section: --bw-accent, --bw-ink, --bw-card, --bw-sticky-top */
  --bw-muted: color-mix(in srgb, currentColor 62%, transparent);
  --bw-line: color-mix(in srgb, currentColor 14%, transparent);
  --bw-tint: color-mix(in srgb, var(--bw-accent) 6%, var(--bw-card));
  --bw-radius: 12px;
  padding: 40px 16px;
  font-family: inherit;
}
.bw [hidden] { display: none !important; }
.bw-vh { position: absolute !important; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.bw-placeholder { max-width: 560px; margin: 0 auto 12px; padding: 16px; text-align: center; border: 1px dashed var(--bw-line); border-radius: var(--bw-radius); color: var(--bw-muted); }

/* ── Stepper (desktop) ── */
.bw-stepper { display: flex; justify-content: center; margin: 0 auto 40px; padding: 0; list-style: none; }
.bw-stepper__item { position: relative; width: 84px; display: flex; flex-direction: column; align-items: center; gap: 8px;
  font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--bw-muted); }
.bw-stepper__item + .bw-stepper__item::before { content: ""; position: absolute; top: 15px; right: calc(50% + 22px);
  width: calc(100% - 44px); height: 2px; background: var(--bw-line); }
.bw-stepper__item.is-done::before, .bw-stepper__item.is-current::before { background: var(--bw-ink); }
.bw-stepper__dot { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-size: 13px; font-weight: 600;
  background: var(--bw-card); border: 1px solid var(--bw-line); color: inherit; }
.bw-stepper__item.is-done, .bw-stepper__item.is-current { color: inherit; font-weight: 600; }
.bw-stepper__item.is-done .bw-stepper__dot, .bw-stepper__item.is-current .bw-stepper__dot { background: var(--bw-ink); border-color: var(--bw-ink); color: #fff; }

/* ── Summary: total on top ── */
.bw-summary { max-width: 560px; margin: -16px auto 28px; display: flex; justify-content: center; align-items: center; }
.bw-summary__step { display: none; }
.bw-summary__total { display: inline-flex; align-items: baseline; gap: 8px; padding: 7px 16px; border-radius: 999px; background: var(--bw-card); border: 1px solid var(--bw-line); }
.bw-summary__label { font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--bw-muted); }
.bw-summary__amount { font-size: 18px; font-weight: 800; white-space: nowrap; }
.bw-summary__total.is-bump .bw-summary__amount { animation: bw-bump .3s ease-out; }
.bw-progress { display: block; height: 3px; border-radius: 3px; background: var(--bw-line); overflow: hidden; }
.bw-progress__bar { display: block; width: 0; height: 100%; border-radius: 3px; background: var(--bw-accent); transition: width .3s ease; }

/* ── Step & headings ── */
.bw-step { max-width: 760px; margin: 0 auto; text-align: center; }
.bw-h { margin: 0 0 10px; font-size: clamp(24px, 4vw, 32px); line-height: 1.15; font-weight: 700; letter-spacing: -.01em; }
.bw-h:focus { outline: none; }
.bw-sub { margin: 0 auto 28px; font-size: 16px; color: var(--bw-muted); }
.bw-sub--narrow { max-width: 340px; }

/* ── Option rows ── */
.bw-opts { max-width: 560px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; text-align: left; }
.bw-opt { position: relative; display: flex; align-items: center; gap: 14px; padding: 18px 20px; cursor: pointer;
  background: var(--bw-card); border: 2px solid var(--bw-line); border-radius: 14px;
  transition: border-color .15s, background-color .15s, box-shadow .15s, transform .1s; }
.bw-opt:hover { border-color: color-mix(in srgb, var(--bw-accent) 45%, var(--bw-card)); }
.bw-opt:active { transform: scale(.99); }
.bw-opt:has(input:focus-visible) { outline: 3px solid color-mix(in srgb, var(--bw-accent) 35%, transparent); outline-offset: 2px; }
.bw-opt.is-selected { border-color: var(--bw-accent); background: var(--bw-tint); box-shadow: 0 4px 14px color-mix(in srgb, var(--bw-accent) 14%, transparent); }
